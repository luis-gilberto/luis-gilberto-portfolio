// Creative Portal - Prisma Schema
// Complete database schema for client project management platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  ADMIN
  TEAM_MEMBER
  CLIENT
}

enum ProjectType {
  WEB_DESIGN
  BRAND_IDENTITY
  DIGITAL_STRATEGY
  ECOMMERCE
  MOBILE_APP
}

enum ProjectStatus {
  DISCOVERY
  DESIGN
  DEVELOPMENT
  REVIEW
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PhaseStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum DeliverableType {
  DESIGN
  DEVELOPMENT
  DOCUMENT
  TRAINING
  OTHER
}

enum DeliverableStatus {
  PENDING
  IN_PROGRESS
  REVIEW
  APPROVED
  COMPLETED
}

enum MessageType {
  MESSAGE
  UPDATE
  APPROVAL_REQUEST
  CHANGE_REQUEST
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum AccessLevel {
  PUBLIC
  CLIENT
  TEAM
  ADMIN
}

enum FeedbackType {
  APPROVAL
  REVISION_REQUEST
  GENERAL_FEEDBACK
}

enum FeedbackStatus {
  PENDING
  ADDRESSED
  RESOLVED
}

// Models
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  role         UserRole @default(CLIENT)
  firstName    String?
  lastName     String?
  avatarUrl    String?
  companyName  String?
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastLogin    DateTime?
  isActive     Boolean  @default(true)

  // Relations
  company           Company?      @relation(fields: [companyId], references: [id])
  companyId         String?
  projectsAsClient  Project[]     @relation("ClientProjects")
  sentMessages      Message[]
  uploadedFiles     File[]
  invoices          Invoice[]
  assignedTasks     Task[]
  activities        Activity[]
  feedback          Feedback[]
  approvedDeliverables Deliverable[] @relation("ApprovedBy")

  @@map("users")
}

model Company {
  id             String   @id @default(cuid())
  name           String
  industry       String?
  website        String?
  logoUrl        String?
  billingAddress Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  users    User[]
  projects Project[]

  @@map("companies")
}

model Project {
  id                 String        @id @default(cuid())
  name               String
  description        String?
  type               ProjectType
  status             ProjectStatus @default(DISCOVERY)
  priority           Priority      @default(MEDIUM)
  budgetAmount       Decimal?
  budgetCurrency     String        @default("USD")
  startDate          DateTime?
  dueDate            DateTime?
  estimatedHours     Int?
  actualHours        Int?
  progressPercentage Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Relations
  client      User?    @relation("ClientProjects", fields: [clientId], references: [id])
  clientId    String?
  company     Company? @relation(fields: [companyId], references: [id])
  companyId   String?
  phases      ProjectPhase[]
  deliverables Deliverable[]
  messages    Message[]
  files       File[]
  invoices    Invoice[]
  tasks       Task[]
  activities  Activity[]
  feedback    Feedback[]

  @@map("projects")
}

model ProjectPhase {
  id                String      @id @default(cuid())
  name              String
  description       String?
  orderIndex        Int
  status            PhaseStatus @default(PENDING)
  estimatedDuration Int? // in days
  startDate         DateTime?
  endDate           DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Relations
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String
  deliverables Deliverable[]

  @@map("project_phases")
}

model Deliverable {
  id          String            @id @default(cuid())
  name        String
  description String?
  type        DeliverableType
  status      DeliverableStatus @default(PENDING)
  dueDate     DateTime?
  approvedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  phase       ProjectPhase? @relation(fields: [phaseId], references: [id])
  phaseId     String?
  approvedBy  User?        @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedById String?
  files       File[]
  feedback    Feedback[]

  @@map("deliverables")
}

model Message {
  id              String      @id @default(cuid())
  content         String
  type            MessageType @default(MESSAGE)
  isInternal      Boolean     @default(false)
  readBy          Json        @default("[]")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  sender          User     @relation(fields: [senderId], references: [id])
  senderId        String
  parentMessage   Message? @relation("MessageThread", fields: [parentMessageId], references: [id])
  parentMessageId String?
  replies         Message[] @relation("MessageThread")

  @@map("messages")
}

model File {
  id               String      @id @default(cuid())
  filename         String
  originalFilename String
  fileType         String?
  fileSize         Int
  storageUrl       String
  thumbnailUrl     String?
  version          Int         @default(1)
  isFinal          Boolean     @default(false)
  accessLevel      AccessLevel @default(CLIENT)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  deliverable   Deliverable? @relation(fields: [deliverableId], references: [id])
  deliverableId String?
  uploader      User         @relation(fields: [uploaderId], references: [id])
  uploaderId    String

  @@map("files")
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  amount          Decimal
  currency        String        @default("USD")
  status          InvoiceStatus @default(DRAFT)
  dueDate         DateTime?
  paidDate        DateTime?
  stripeInvoiceId String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  client   User    @relation(fields: [clientId], references: [id])
  clientId String

  @@map("invoices")
}

model Task {
  id             String     @id @default(cuid())
  title          String
  description    String?
  priority       Priority   @default(MEDIUM)
  status         TaskStatus @default(TODO)
  dueDate        DateTime?
  estimatedHours Decimal?
  actualHours    Decimal?
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Relations
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  assignee   User?   @relation(fields: [assigneeId], references: [id])
  assigneeId String?

  @@map("tasks")
}

model Activity {
  id          String   @id @default(cuid())
  actionType  String
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  // Relations
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  user      User    @relation(fields: [userId], references: [id])
  userId    String

  @@map("activities")
}

model Feedback {
  id           String         @id @default(cuid())
  rating       Int?
  comment      String?
  type         FeedbackType
  status       FeedbackStatus @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Relations
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  deliverable   Deliverable? @relation(fields: [deliverableId], references: [id])
  deliverableId String?
  client        User         @relation(fields: [clientId], references: [id])
  clientId      String

  @@map("feedback")
}
