# 301 Redirects for Site Cleanup
RewriteEngine On

# 301 Redirects for renamed pages
Redirect 301 /planning-hub /IMCServices/planning-hub/
Redirect 301 /scope-intelligence /IMCServices/scopeiq-wizard/

# Hub 2.0 Routing
RewriteRule ^TheHub/?$ /TheHub/index.html [L]

# Redirect planning-hub to scope-intelligence
RewriteRule ^IMCServices/planning-hub/?(.*)$ /scope-intelligence/$1 [R=301,L]

# Redirect scope-intelligence to IMCServices location
RewriteRule ^scope-intelligence/?(.*)$ /IMCServices/scope-intelligence-app/$1 [R=301,L]

# Hide asset folders from public access
RewriteRule ^IMCServices/planning-hub/assets/ - [F,L]

# Block direct access to toolkit directory - redirect to engagement-toolkit
RewriteRule ^IMCServices/toolkit/?(.*)$ /IMCServices/engagement-toolkit/ [R=301,L]

# Block engagement-toolkit directory with trailing slash - redirect to clean URL
RewriteRule ^IMCServices/engagement-toolkit/$ /IMCServices/engagement-toolkit [R=301,L]

# Custom 404 page
ErrorDocument 404 /404.html

# Redirect legacy/dev CV files to main CV
Redirect 301 /cv_legacy.html /cv.html
Redirect 301 /cv_optimized.html /cv.html
Redirect 301 /cv_optimized1.html /cv.html
Redirect 301 /cv_optimized2.html /cv.html

# StrategyIQ Redirects
Redirect 301 /TheHub/strategyiq/ /TheHub/strategy-iq/
Redirect 301 /strategyiq/ /TheHub/strategy-iq/

# PDF Headers
<FilesMatch "\.pdf$">
    <IfModule mod_headers.c>
        Header set Cache-Control "public, max-age=0, must-revalidate"
        Header set Content-Disposition "inline"
    </IfModule>
</FilesMatch>