/assets/CSC_Brand_Assets/* /TheHub/clients/nari/assets/CSC_Brand_Assets/:splat 200
/TheHub/clients/nari/assets/* /TheHub/clients/nari/assets/:splat 200

# Nari Dashboard
/nari        /TheHub/clients/nari/index.html       200
/nari/files  /TheHub/clients/nari/files/           200

# LG Studio (explicit directory serving)
/studio              /studio/                          301
/studio/assets       /studio/assets/                   301
/studio/gracias-erika /studio/gracias-erika/           301
/studio/             /studio/index.html                200
/studio/assets/      /studio/assets/index.html         200
/studio/gracias-erika/ /studio/gracias-erika/index.html 200

# Book (Microsoft Bookings)
/book              /book/                   301
/book/             /book/index.html         200

