# Redirects
/intake/* /TheHub/clients/nari/:splat 301
/clients/* /TheHub/clients/:splat 301

# Client Dashboard Proxies (Direct Mapping)
# These rules ensure that even if there is a catch-all, these paths are served correctly.
/assets/CSC_Brand_Assets/* /TheHub/clients/nari/assets/CSC_Brand_Assets/:splat 200
/TheHub/clients/nari/assets/* /TheHub/clients/nari/assets/:splat 200

# Nari Dashboard
/nari        /TheHub/clients/nari/index.html       200
/nari/files  /TheHub/clients/nari/files/           200

# NO GLOBAL CATCH-ALL
# Removing /* /index.html 200 as it intercepts static assets on subdomains.
