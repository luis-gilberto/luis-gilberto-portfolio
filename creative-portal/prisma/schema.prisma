generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  image         String?
  emailVerified DateTime?
  role          String    @default("CLIENT") // ADMIN or CLIENT
  createdAt     DateTime  @default(now())
  projects      Project[]
  accounts      Account[]
  sessions      Session[]

  assessments AssessmentSession[]

  @@map("User")
}

model Project {
  id          String     @id @default(cuid())
  title       String
  status      String     @default("Active")
  startDate   DateTime   @default(now())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents   Document[]
}

model Document {
  id        String   @id @default(cuid())
  name      String
  type      String   // Invoice, Contract, Asset
  url       String
  size      String
  uploadedAt DateTime @default(now())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ===============================
// NextAuth models
// ===============================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AssessmentSession {
  id                     String    @id @default(cuid())
  clientId               String?   @map("client_id") // The CLIENT being assessed (No FK here)
  consultantId           String?   @map("consultant_id")
  assessment_type        String?
  strategic_area         String?
  current_question       Int?      @default(0)
  responses              Json?
  intelligence_score     Decimal?
  area_scores            Json?
  complexity_indicators  Json?
  status                 String?   @default("in_progress")
  consultant_notes       String?
  key_insights           String[]
  startedAt              DateTime? @default(now())
  completedAt            DateTime?
  duration_minutes       Int?

  client                 User?     @relation(fields: [consultantId], references: [id])

  @@map("assessment_sessions")
}
