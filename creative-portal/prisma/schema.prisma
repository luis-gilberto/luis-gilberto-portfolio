generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  image         String?
  emailVerified DateTime?
  role          String    @default("CLIENT")
  authorityLevel Int      @default(1)
  title         String?
  clientId      String?
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sentMessages  Message[]
  projects      Project[]
  sessions      Session[]
  client        Client?   @relation(fields: [clientId], references: [id])

  @@map("User")
}

model Client {
  id                 String              @id @default(cuid())
  name               String
  company            String?
  email              String?             @unique
  status             String              @default("Active")
  contact            String?
  phone              String?
  projectType        String?
  budgetRange        String?
  timeline           String?
  companySize        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  projects           Project[]
  assessmentSessions AssessmentSession[]
  users              User[]
}

model Project {
  id                 String              @id @default(cuid())
  title              String
  status             String              @default("DISCOVERY")
  startDate          DateTime            @default(now())
  userId             String
  clientId           String?
  brandStatus        String              @default("PENDING")
  campaignStatus     String              @default("PENDING")
  creativeStatus     String              @default("PENDING")
  gtmStatus          String              @default("PENDING")
  businessOKRs       String?             @db.Text
  strategicConstraints String?           @db.Text
  primaryBusinessGoals String?           @db.Text
  customId           String?             @unique
  businessDriver     String?             @default("")
  metricName         String?             @default("")
  metricTarget       String?             @default("")
  metricBaseline     String?             @default("")
  operationalPriority String?            @default("")
  cacCurrent         String?             @default("")
  cacGoal            String?             @default("")
  ltvCurrent         String?             @default("")
  ltvGoal            String?             @default("")
  conversionCurrent  String?             @default("")
  conversionGoal     String?             @default("")
  marketingSignal    String?             @db.Text
  marketingNoise     String?             @db.Text
  channels           String[]
  masterRoadmap      String?             @db.Text
  masterPlan         Json?
  overallIntelligenceScore Int?
  quotedInvestment   String?
  roadmapStatus      String              @default("PENDING")
  updatedAt          DateTime            @default(now()) @updatedAt
  pendingAuthorityRequest Boolean        @default(false) @map("pending_authority_request")
  authorityGrantedAt DateTime?           @map("authority_granted_at")
  deliverables       Deliverable[]
  documents          Document[]
  messages           Message[]
  milestones         Milestone[]
  client             Client?             @relation(fields: [clientId], references: [id])
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  timelineEvents     TimelineEvent[]
  assessmentSessions AssessmentSession[]
}

model Document {
  id         String   @id @default(cuid())
  name       String
  type       String
  url        String
  size       String
  uploadedAt DateTime @default(now())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Milestone {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  status    String   @default("Pending")
  order     Int      @default(0)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Deliverable {
  id        String    @id @default(cuid())
  title     String
  fileUrl   String?
  type      String
  status    String    @default("Draft")
  projectId String
  createdAt DateTime  @default(now())
  dueDate   DateTime?
  updatedAt DateTime  @default(now()) @updatedAt
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model TimelineEvent {
  id          String   @id @default(cuid())
  date        DateTime
  description String
  type        String
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id @default(cuid())
  content   String
  senderId  String   @map("sender_id")
  projectId String   @map("project_id")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  archivedAt DateTime? @map("archived_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("project_messages")
}

model AssessmentSession {
  id                 String   @id @default(cuid())
  clientId           String   @map("client_id")
  consultantId       String   @map("consultant_id")
  assessmentType     String   @map("assessment_type")
  status             String   @default("in_progress")
  responses          String?
  intelligenceScore  Int?     @map("intelligence_score")
  currentQuestion    Int?     @map("current_question")
  startedAt          DateTime @default(now()) @map("started_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")
  isPublished        Boolean  @default(false) @map("is_published")
  briefSummary       String?  @map("brief_summary")
  projectId          String?  @map("project_id")
  consultantAnalysis String?  @map("consultant_analysis")
  certifiedNarrative String?  @map("certified_narrative")
  currentState       Json?    @map("current_state")
  authorityLock      AuthorityLock @default(CLIENT) @map("authority_lock")
  client             Client   @relation(fields: [clientId], references: [id])
  project            Project? @relation(fields: [projectId], references: [id])
  auditLogs          SessionAuditLog[]

  @@unique([projectId, assessmentType])
  @@map("assessment_sessions")
}

model SessionAuditLog {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  actorRole String   @map("actor_role")
  eventType String   @map("event_type")
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")
  session   AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_audit_logs")
}

enum AuthorityLock {
  CLIENT
  CONSULTANT_AUTHORIZED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
