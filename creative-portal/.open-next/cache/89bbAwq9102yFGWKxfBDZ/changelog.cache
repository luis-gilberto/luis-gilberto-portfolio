/script><main class=\"max-w-4xl mx-auto px-6 py-10 space-y-8\"><header class=\"space-y-3\"><h1 class=\"text-3xl font-bold\">Portal Changelog</h1><p class=\"text-[var(--text-secondary)]\">Version <!-- -->0.1.0<!-- -->  ·  Deployed to <!-- -->Cloudflare Workers (OpenNext)</p></header><section class=\"grid grid-cols-1 md:grid-cols-2 gap-6\"><div class=\"rounded-xl border border-[var(--border-subtle)] bg-[var(--card-bg)] p-4\"><h2 class=\"text-xl font-semibold mb-2\">Highlights</h2><ul class=\"space-y-2\"><li class=\"text-sm\"><span class=\"font-medium\">Global navigation polish and mobile drawer</span><span class=\"text-[var(--text-secondary)]\">: <!-- -->Clear ecosystem links and streamlined Portal access on mobile</span></li><li class=\"text-sm\"><span class=\"font-medium\">Authentication flows (sign in, sign up, verify)</span><span class=\"text-[var(--text-secondary)]\">: <!-- -->Secure access with NextAuth + Prisma adapter</span></li><li class=\"text-sm\"><span class=\"font-medium\">Dashboard overview</span><span class=\"text-[var(--text-secondary)]\">: <!-- -->At-a-glance status with navigation to key areas</span></li><li class=\"text-sm\"><span class=\"font-medium\">Projects: list, detail, and create</span><span class=\"text-[var(--text-secondary)]\">: <!-- -->Organize initiatives and track work by project</span></li><li class=\"text-sm\"><span class=\"font-medium\">Documents area</span><span class=\"text-[var(--text-secondary)]\">: <!-- -->Centralized client assets with consistent UI</span></li><li class=\"text-sm\"><span class=\"font-medium\">Messages module</span><span class=\"text-[var(--text-secondary)]\">: <!-- -->Consolidated communication surface inside Portal</span></li><li class=\"text-sm\"><span class=\"font-medium\">StrategyIQ assessments + KB modal</span><span class=\"text-[var(--text-secondary)]\">: <!-- -->Structured evaluation with contextual knowledge base</span></li><li class=\"text-sm\"><span class=\"font-medium\">Admin surface</span><span class=\"text-[var(--text-secondary)]\">: <!-- -->Administrative controls for accounts and platform</span></li><li class=\"text-sm\"><span class=\"font-medium\">Session provider and middleware</span><span class=\"text-[var(--text-secondary)]\">: <!-- -->Stable auth context and protected routes</span></li><li class=\"text-sm\"><span class=\"font-medium\">Deployment config and scripts</span><span class=\"text-[var(--text-secondary)]\">: <!-- -->Repeatable builds and worker deployment via OpenNext</span></li></ul></div><div class=\"rounded-xl border border-[var(--border-subtle)] bg-[var(--card-bg)] p-4 flex items-center justify-center\"><img alt=\"Portal\" loading=\"lazy\" width=\"280\" height=\"80\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fassets%2Fimages%2FThe_Portal_Logo.png&amp;w=384&amp;q=75 1x, /_next/image?url=%2Fassets%2Fimages%2FThe_Portal_Logo.png&amp;w=640&amp;q=75 2x\" src=\"/_next/image?url=%2Fassets%2Fimages%2FThe_Portal_Logo.png&amp;w=640&amp;q=75\"/></div></section><section class=\"rounded-xl border border-[var(--border-subtle)] bg-[var(--card-bg)] p-4\"><h2 class=\"text-xl font-semibold mb-2\">Screens &amp; Examples</h2><ul class=\"text-sm space-y-2\"><li><a class=\"text-[var(--coral)]\" href=\"/dashboard\">Dashboard</a>: overview and quick navigation</li><li><a class=\"text-[var(--coral)]\" href=\"/projects\">Projects</a>: active projects list</li><li><a class=\"text-[var(--coral)]\" href=\"/documents\">Documents</a>: client assets</li><li><a class=\"text-[var(--coral)]\" href=\"/strategyiq\">StrategyIQ</a>: assessments and KB modal</li><li><a class=\"text-[var(--coral)]\" href=\"/admin\">Admin</a>: admin controls</li><li><a class=\"text-[var(--coral)]\" href=\"/auth/signin\">Sign In</a>: authentication entry</li></ul></section><section class=\"rounded-xl border border-[var(--border-subtle)] bg-[var(--card-bg)] p-4\"><h2 class=\"text-xl font-semibold mb-2\">Deployment</h2><ul class=\"text-sm space-y-2\"><li>Target: <!-- -->Cloudflare Workers (OpenNext)<!-- --> via <code>@opennextjs/cloudflare</code> and <code>wrangler</code></li><li>Scripts: <code>npm run preview</code>, <code>npm run deploy</code></li><li>Auth &amp; data: NextAuth + Prisma (see <code>lib/auth.ts</code>, <code>prisma/schema.prisma</code>)</li></ul></section><section class=\"rounded-xl border border-[var(--border-subtle)] bg-[var(--card-bg)] p-4\"><h2 class=\"text-xl font-semibold mb-2\">Known Issues</h2><ul class=\"text-sm space-y-2\"><li>Autoplay limitations for media, depending on browser policies</li><li>Edge cases in project detail routes when unauthenticated</li><li>Deployment preview may differ from local dev styling due to worker runtime</li></ul></section></main><!--$--><!--/$--><div class=\"fixed bottom-8 right-8 z-[100] flex flex-col gap-4 pointer-events-none\"></div><script src=\"/_next/static/chunks/cac5d456dc7f52db.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[85437,[\\\"/_next/static/chunks/195c216f52dae3f8.js\\\",\\\"/_next/static/chunks/67c2cd477ee241de.js\\\",\\\"/_next/static/chunks/f1c5c80275fb7bba.js\\\",\\\"/_next/static/chunks/8e26859234112358.js\\\"],\\\"Image\\\"]\\n3:I[24910,[\\\"/_next/static/chunks/195c216f52dae3f8.js\\\",\\\"/_next/static/chunks/67c2cd477ee241de.js\\\",\\\"/_next/static/chunks/f1c5c80275fb7bba.js\\\"],\\\"AppProviders\\\"]\\n4:I[39756,[\\\"/_next/static/chunks/ff1a16fafef87110.js\\\",\\\"/_next/static/chunks/650b0d2d0b895b93.js\\\"],\\\"default\\\"]\\n5:I[37457,[\\\"/_next/static/chunks/ff1a16fafef87110.js\\\",\\\"/_next/static/chunks/650b0d2d0b895b93.js\\\"],\\\"default\\\"]\\n6:I[29306,[\\\"/_next/static/chunks/195c216f52dae3f8.js\\\",\\\"/_next/static/chunks/67c2cd477ee241de.js\\\",\\\"/_next/static/chunks/f1c5c80275fb7bba.js\\\",\\\"/_next/static/chunks/f4bf1d2ae8aa3992.js\\\"],\\\"default\\\"]\\n14:I[68027,[],\\\"default\\\"]\\n:HL[\\\"/_