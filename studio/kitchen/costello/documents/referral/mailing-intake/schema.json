{
  "purpose": "Expected Costello referral-letter mailing-list schema. No recipient rows. List not received.",
  "acceptedInput": [".xlsx", ".xls", ".csv"],
  "productionOutputWhenReceived": "Costello_Mailing_List_PRODUCTION_YYYY-MM-DD.xlsx",
  "productionOutputAlternate": "CSV only if the selected printer requires CSV",
  "personalizationField": "First Name",
  "letterMergeTokenProof": "«FirstName»",
  "letterSalutation": "Dear [First Name],",
  "blankFirstName": "Flag for review. Do not invent a salutation fallback.",
  "addressCorrection": "Not authoritative in this intake. CASS/NCOA remains printer/vendor responsibility unless otherwise agreed.",
  "columns": [
    { "name": "First Name", "required": true, "role": "personalization" },
    { "name": "Last Name", "required": true, "role": "identity" },
    { "name": "Firm / Company", "required": false, "role": "identity" },
    { "name": "Address 1", "required": true, "role": "street" },
    { "name": "Address 2 / Suite", "required": false, "role": "street" },
    { "name": "City", "required": true, "role": "locality" },
    { "name": "State", "required": true, "role": "region" },
    { "name": "ZIP", "required": true, "role": "postal" },
    { "name": "Email", "required": false, "role": "optional" },
    { "name": "Internal Note", "required": false, "role": "optional" }
  ]
}
