{
  "name": "luis-gilberto-portfolio-static",
  "version": "1.0.0",
  "description": "Static portfolio site",
  "private": true,
  "scripts": {
    "build": "echo 'Building static site...' && exit 0",
    "test": "echo 'No tests' && exit 0",
    "sync:csc-es": "node scripts/sync-csc-es.mjs",
    "sync:csc-es:check": "node scripts/sync-csc-es.mjs --check",
    "prepublish:csc": "node scripts/sync-csc-es.mjs --check && node scripts/qa-csc-prepub.mjs",
    "qa:csc-locale": "node scripts/qa-csc-locale.mjs",
    "vercel-ignore": "git diff --quiet HEAD^ HEAD creative-portal/",
    "sync:contact": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-contact.ps1"
  },
  "devDependencies": {
    "puppeteer": "^24.35.0"
  }
}
