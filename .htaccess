# 301 Redirects for Site Cleanup
RewriteEngine On

# Redirect planning-hub to scope-intelligence
RewriteRule ^IMCServices/planning-hub/?(.*)$ /scope-intelligence/$1 [R=301,L]

# Redirect scope-intelligence to IMCServices location
RewriteRule ^scope-intelligence/?(.*)$ /IMCServices/scope-intelligence-app/$1 [R=301,L]

# Hide asset folders from public access
RewriteRule ^IMCServices/planning-hub/assets/ - [F,L]

# Block direct access to toolkit directory - redirect to engagement-toolkit
RewriteRule ^IMCServices/toolkit/?(.*)$ /IMCServices/engagement-toolkit/ [R=301,L]

# Block engagement-toolkit directory with trailing slash - redirect to clean URL
RewriteRule ^IMCServices/engagement-toolkit/$ /IMCServices/engagement-toolkit [R=301,L]

# Custom 404 page
ErrorDocument 404 /404.html